#!/usr/bin/env bash
# ABC (Automated Behaviour Coder) launcher.
#
# Runs the CLI from this checkout without needing an install, so a cluster
# deployment is "git clone, run setup, put bin on PATH". If an ABC virtualenv
# exists next to the checkout or at $ABC_VENV, its interpreter is used.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(dirname "$here")"

python="${ABC_PYTHON:-}"
if [ -z "$python" ]; then
  # Built conditionally: "${VAR:-}/bin/python" with VAR unset yields the
  # non-empty string "/bin/python", which exists on many systems, so testing
  # the candidate for "non-empty" would silently pick the wrong interpreter.
  # .venv-client comes last: it is the client environment, which has codecs but
  # none of the engines -- still better than the system python on a machine
  # that only ever runs the client.
  candidates=()
  [ -n "${ABC_VENV:-}" ]        && candidates+=("$ABC_VENV/bin/python")
  candidates+=("$root/.venv/bin/python")
  [ -n "${HOME:-}" ]            && candidates+=("$HOME/abc_env/bin/python")
  [ -n "${ABC_CLIENT_VENV:-}" ] && candidates+=("$ABC_CLIENT_VENV/bin/python")
  candidates+=("$root/.venv-client/bin/python")
  for candidate in "${candidates[@]}"; do
    if [ -x "$candidate" ]; then python="$candidate"; break; fi
  done
fi
python="${python:-python3}"

export PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}"
exec "$python" -m abcoder.server.cli "$@"
